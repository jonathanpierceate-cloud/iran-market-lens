# Local storage
DATA_DIR=./data
DATABASE_PATH=./data/market.db

# Refresh and data quality
DATA_UPDATE_INTERVAL=900
HTTP_TIMEOUT_SECONDS=15
MAX_STALE_HOURS=36

# Official / market provider endpoints can be changed without editing source files.
RAHAVARD_API_BASE_URL=https://rahavard365.com/api/v2
RAHAVARD_PUBLIC_BARS_URL=https://rahavard365.com/api/v2/chart/public-bars
RAHAVARD_ETF_FUNDS_URL=https://rahavard365.com/api/v2/market-data/etf-funds
RAHAVARD_LIGHT_BARS_URL=https://rahavard365.com/api/v2/chart/light-bars
TABDEAL_TRADES_URL=https://api1.tabdeal.org/r/api/v1/trades
CODAL_API_URL=https://search.codal.ir/api/search/v2/q

# Optional override: comma-separated RSS URLs. Blank uses the built-in Tasnim market feeds.
NEWS_RSS_URLS=https://www.tasnimnews.ir/fa/rss/feeds/84/0/0/0,https://www.tasnimnews.ir/fa/rss/feeds/79/0/0/0
